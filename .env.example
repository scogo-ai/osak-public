# Copy this file to .env for local development. Never commit the copy.
# Production uses the same variable names in a mode-0600 host-only .env.

# Compose isolation. Keep local and production names distinct when both are on
# one Docker host.
OSAK_LOCAL_COMPOSE_PROJECT=osak-local
OSAK_PROD_COMPOSE_PROJECT=osak-prod
OSAK_ENV=local
OSAK_BUILD_VERSION=local
LOG_LEVEL=INFO

# Local database (the service name is postgres inside Compose).
POSTGRES_IMAGE=postgres:16.6-alpine
POSTGRES_DB=osak
POSTGRES_USER=osak
POSTGRES_PASSWORD=change-me-local
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://osak:change-me-local@postgres:5432/osak

# Application secrets. Generate long random values for every installation.
# These secrets are used for HMAC key hashing and origin-to-edge protection.
OSAK_KEY_PEPPER=replace-with-a-random-32-byte-value
OSAK_ORIGIN_SHARED_SECRET=replace-with-a-random-32-byte-value

# Persistent application data inside the API/worker containers.
OSAK_DATA_DIR=/var/lib/osak/data
OSAK_WORKER_HEARTBEAT_FILE=/var/lib/osak/data/worker-heartbeat
OSAK_PUBLIC_BASE_URL=http://127.0.0.1:8000
OSAK_EMAIL_FROM=OSAK Local <osak@localhost>
OSAK_ADMIN_ACCESS_TOKEN=local-admin-token

# Local API and Mailpit are bound to loopback only.
OSAK_API_PORT=8000
MAILPIT_IMAGE=axllent/mailpit:v1.21.8
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MAILPIT_MAX_MESSAGES=5000
EMAIL_BACKEND=mailpit
MAILPIT_API_URL=http://mailpit:8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_STARTTLS=false
TURNSTILE_SECRET_KEY=

# Ingestion controls. Set INGEST_ENABLED=false when working only on the API.
INGEST_ENABLED=true
GOCSAF_VERSION=v3.7.1

# Production-only values. Keep these commented or empty in local .env files.
# OSAK_ENV=production
# OSAK_API_IMAGE=ghcr.io/your-owner/your-repository-api
# OSAK_WORKER_IMAGE=ghcr.io/your-owner/your-repository-worker
# OSAK_IMAGE_TAG=replace-with-git-sha
# CLOUDFLARED_TUNNEL_TOKEN=keep-only-on-the-origin-host
# RESEND_API_KEY=re_keep-only-on-the-origin-host
# OSAK_EMAIL_FROM=OSAK <osk@noreply.scogo.ai>
# OSAK_PUBLIC_BASE_URL=https://osak.lab.scogo.ai
# OSAK_ADMIN_ACCESS_TOKEN=keep-only-on-the-origin-host
# TURNSTILE_SECRET_KEY=0x_keep-only-on-the-origin-host
# BACKUP_INTERVAL_SECONDS=86400
# BACKUP_RETENTION_DAYS=14

# `osak seed --dev` creates a local osak_test_... key and prints it once. Do
# not put that key in this file; use it in the shell that runs local tests.
# OSAK_TEST_KEY=<printed-by-osak-seed---dev>

# Optional publisher credentials, used only by the worker.
NVD_API_KEY=
# Optional Software Checker release queries from the operator-owned public catalog.
OSAK_CISCO_CHECKER_QUERIES=[]
CISCO_CLIENT_ID=
CISCO_CLIENT_SECRET=
# cisco_eox is an optional end-of-life feed. Leave it out for the standard service.
OSAK_ENABLED_SOURCES=
OSAK_DISABLED_SOURCES=
OSAK_REVIEWED_SOURCE_ALLOWLIST=
# CT203 production defaults to cisco,fortinet,arista. Other profiles are unrestricted.
# OSAK_VENDOR_SCOPE=cisco,fortinet,arista
